# 編輯器共用設定（VS Code 需安裝 EditorConfig 擴充套件）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 樣板與靜態檔使用 2 格縮排
[*.{html,css,js,json,svg,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
