# =============================================================
# InvoiceGuard-AI-ADMIN 後台網站環境變數範本
# - 僅列設定名稱與安全預設值；不得填入公司密鑰後交給開發者
# - 程式預設不讀取 .env；本機只使用公開程序設定
# - Vercel：於 Project Settings → Environment Variables 設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production（非 local 時 cookie 只走 HTTPS）
APP_ENV=local
DEBUG=false
MODULE_BACKEND=auto
REMOTE_ADMIN_BASE_URL=

# ---- 資料庫（與 InvoiceGuard-AI-API 相同的 PostgreSQL，使用 pooled 連線字串）----
DATABASE_URL=
DB_POOL_MODE=transaction
DB_SSL_MODE=require
DB_CONNECT_TIMEOUT_SECONDS=5

# ---- 雲端 Storage（目前只驗證設定與契約，尚未接線）----
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=

# ---- 登入狀態 ----
# 簽署登入 cookie 的金鑰，至少 32 字元的隨機字串（變更後所有人需重新登入）
SESSION_SECRET_KEY=
# 登入有效秒數（預設 8 小時）
SESSION_MAX_AGE_SECONDS=28800

# ---- 雲端選填；本階段不使用模型 API ----
GEMINI_API_KEY=
OPENAI_API_KEY=
