# =============================================================
# InvoiceGuard-AI-ADMIN 後台網站環境變數範本
# - 本機：複製為 .env 後填值（.env 不得提交版控）
# - Vercel：於 Project Settings → Environment Variables 設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production（非 local 時 cookie 只走 HTTPS）
APP_ENV=local
DEBUG=true

# ---- 資料庫（與 InvoiceGuard-AI-API 相同的 PostgreSQL，使用 pooled 連線字串）----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoiceguard

# ---- 登入狀態 ----
# 簽署登入 cookie 的金鑰，至少 32 字元的隨機字串（變更後所有人需重新登入）
SESSION_SECRET_KEY=change-me-to-a-long-random-string
# 登入有效秒數（預設 8 小時）
SESSION_MAX_AGE_SECONDS=28800
