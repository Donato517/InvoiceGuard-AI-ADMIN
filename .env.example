# =============================================================
# InvoiceGuard-AI-ADMIN 後台網站環境變數範本
# - 僅列設定名稱與安全預設值；不得填入公司密鑰後交給開發者
# - 不讀 dotenv；本機公開 URL 使用 STARTUP/dev-urls.local.json
# - Vercel：於 Project Settings → Environment Variables 分 Preview／Production 設定
# - VERCEL／VERCEL_ENV 由平台注入；APP_ENV 必須對應 preview／production
# - 詳見 docs/ENVIRONMENT_ISOLATION.md；此檔不是可直接套用的雲端設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production（非 local 時 cookie 只走 HTTPS）
APP_ENV=local
DEBUG=false
MODULE_BACKEND=auto
REMOTE_ADMIN_BASE_URL=

# ---- 資料庫（與 InvoiceGuard-AI-API 相同的 PostgreSQL，使用 pooled 連線字串）----
DATABASE_URL=
DB_POOL_MODE=transaction
DB_SSL_MODE=require
DB_CONNECT_TIMEOUT_SECONDS=5

# ---- 雲端 Storage（正式流程尚未接線）----
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SECRET_KEY=
# Supabase Storage S3 相容端點（本機開發檔案頁使用；START 經 Vercel CLI 注入）
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- 登入狀態 ----
# 簽署登入 cookie 的金鑰，至少 32 字元的隨機字串（變更後所有人需重新登入）
SESSION_SECRET_KEY=
# 登入有效秒數（預設 8 小時）
SESSION_MAX_AGE_SECONDS=28800

# ---- 雲端選填；本階段不使用模型 API ----
GEMINI_API_KEY=
OPENAI_API_KEY=
